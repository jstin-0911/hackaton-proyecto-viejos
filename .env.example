# Base legacy
POSTGRES_DB=legacy
POSTGRES_USER=legacy
POSTGRES_PASSWORD=cambiar-esta-clave
LEGACY_DB_HOST=legacy-db
LEGACY_DB_PORT=5432

# Gateway (lo construye el equipo)
GATEWAY_URL=http://gateway:8082
GATEWAY_PORT=8082
PORTAL_UI_PORT=8093
# Quiénes pueden escribir (retiros). mobile NUNCA puede, aunque se agregue aquí.
GATEWAY_WRITE_CONSUMERS=subsidios,portal
# Segundos máximos para conectar con el legacy antes de declararlo caído
LEGACY_CONNECT_TIMEOUT=1
# Plazo máximo total (DNS + conexión + consulta) por llamada al legacy; vencido = 503 LEGACY_UNAVAILABLE
LEGACY_DEADLINE_SECONDS=2.5
# Cada cuántos segundos el gateway reintenta los retiros en cola
OUTBOX_INTERVAL_SECONDS=2
# Estado inicial del dominio Afiliaciones si no existe state/affiliations.mode (LEGACY, DUAL o MODERN)
AFFILIATIONS_DEFAULT_MODE=DUAL

# Un token por consumidor (generen valores propios en .env; no los versionen)
PORTAL_TOKEN=cambiar-portal
SUBSIDIOS_TOKEN=cambiar-subsidios
MOBILE_TOKEN=cambiar-mobile
